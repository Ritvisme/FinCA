# Copy to .env for local dev; set the same keys as env vars in Render for prod.
# NEVER commit the real .env.

# --- required ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
GROQ_API_KEY=gsk_...

# --- environment ---
# "dev" (local, http) or "prod" (deployed, https + cross-site cookies)
ENVIRONMENT=dev
DB_NAME=finca

# Comma-separated allowed frontend origins.
# dev: http://localhost:5173  ·  prod: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- optional ---
GOOGLE_CLIENT_ID=
ADMIN_SETUP_SECRET=
OPENAI_API_KEY=
